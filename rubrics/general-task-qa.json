{
  "name": "General task-output QA rubric",
  "version": "1.0",
  "rules": [
    {
      "id": "required_fields",
      "type": "required_fields",
      "fields": [
        "task_id",
        "task_output"
      ],
      "severity": "high"
    },
    {
      "id": "output_not_empty",
      "type": "non_empty",
      "field": "task_output",
      "severity": "high"
    },
    {
      "id": "unique_task_id",
      "type": "unique",
      "field": "task_id",
      "severity": "critical"
    },
    {
      "id": "score_range",
      "type": "numeric_range",
      "field": "score",
      "min": 0,
      "max": 100,
      "severity": "high"
    },
    {
      "id": "status_allowed",
      "type": "allowed_values",
      "field": "status",
      "values": [
        "pass",
        "fail",
        "needs_review"
      ],
      "severity": "high",
      "fixes": {
        "map": {
          "passed": "pass",
          "failed": "fail",
          "completed": "pass"
        }
      }
    },
    {
      "id": "failure_needs_reason",
      "type": "cross_field",
      "if": {
        "field": "status",
        "equals": "fail"
      },
      "then_required": [
        "failure_reason"
      ],
      "severity": "medium",
      "fixes": {
        "default": "No failure reason documented."
      }
    }
  ],
  "escalation": {
    "min_count": 3,
    "threshold_pct": 10
  }
}